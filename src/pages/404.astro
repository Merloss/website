---
import Shell from '../components/Shell.astro';
import { PROFILE } from '../lib/site';
---

<Shell title={`Not found | ${PROFILE.name}`} noindex>
  <p class="not-found-query fold-in">
    <span class="kw">SELECT</span> * <span class="kw">FROM</span> pages <span class="kw">WHERE</span> path = <span id="missing-path">?</span>
    <span class="sql-meta">0 rows · 0.4ms</span>
  </p>
  <h1 class="title fold-in blur-in" style="animation-delay: 50ms">
    <span class="accent nf-code">404</span><br />Page not found
  </h1>
  <p class="body-text fold-in blur-in" style="animation-delay: 100ms">
    The page you are looking for does not exist or has moved.
  </p>
  <div class="button-row fold-in" style="animation-delay: 150ms">
    <a href="/" class="btn-primary"><span class="shimmer">Back home</span></a>
    <a href="/posts" class="btn-secondary"><span class="shimmer">Read posts</span></a>
  </div>
</Shell>

<script>
  let path = location.pathname;
  try { path = decodeURIComponent(path); } catch {}
  const str = document.createElement('span');
  str.className = 'nf-str';
  const inner = document.createElement('span');
  inner.className = 'nf-path';
  inner.title = path;
  inner.textContent = path;
  str.append("'", inner, "'");
  document.getElementById('missing-path').replaceWith(str);
</script>
